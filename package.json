{
  "name": "errora-widget",
  "version": "1.0.0",
  "description": "Lightweight embeddable bug report widget with screenshot capture",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.widget.config.js --port 3001 --open /demo.html",
    "build": "vite build",
    "build:widget": "vite build --config vite.widget.config.js",
    "build:all": "vite build && vite build --config vite.widget.config.js",
    "preview": "vite preview"
  },
  "keywords": [
    "bug-report",
    "widget",
    "screenshot",
    "feedback"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0"
  }
}
